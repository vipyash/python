def group_anagrams(words):
    groups = {}
    for word in words:
        key = tuple(sorted(word))   # sorted letters as a key
        if key not in groups:
            groups[key] = []
        groups[key].append(word)
    return list(groups.values())

Input = ["eat", "tea", "tan", "ate", "nat", "bat"]
print(group_anagrams(Input))
